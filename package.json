{
  "name": "catalogo-rodeo-b2b",
  "version": "1.0.1",
  "description": "Generador B2B de catalogos comerciales Rodeo",
  "author": "C-TECHPTY",
  "productName": "Catalogo Rodeo B2B",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "node node_modules/@electron/packager/bin/electron-packager.mjs . \"Catalogo Rodeo B2B\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true --icon=build/icon.ico --ignore=\"^/release\" --ignore=\"^/web\" --ignore=\"^/\\.env\" --ignore=\"\\\\.xlsx$\" --ignore=\"\\\\.xlsm$\" --ignore=\"\\\\.xls$\" --ignore=\"\\\\.zip$\"",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:publish": "electron-builder --win nsis --x64 --publish always",
    "dist:portable": "npm run pack"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0"
  },
  "build": {
    "appId": "com.ctechpty.catalogorodeob2b",
    "productName": "Catalogo Rodeo B2B",
    "asar": true,
    "directories": {
      "output": "installer-output",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "script.js",
      "styles.css",
      "fonts/**/*",
      "assets/**/*",
      "hosting/assets/public-catalog.css",
      "hosting/assets/public-catalog.js",
      "hosting/assets/img/no-photo-camera.svg",
      "hosting/assets/brand_templates/**/*",
      "hosting/catalogos_admin/assets/logo-rodeo-azul.png",
      "node_modules/**/*",
      "package.json",
      "!**/.env*",
      "!**/*.sql",
      "!**/*.xlsx",
      "!**/*.xls",
      "!**/*.xlsm",
      "!release*/**",
      "!installer-output/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"],
      "artifactName": "Catalogo-Rodeo-B2B-Setup-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "C-TECHPTY",
        "repo": "catalogo_rodeo"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Catalogo Rodeo B2B",
      "deleteAppDataOnUninstall": false
    }
  }
}
