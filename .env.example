# Catalogo Rodeo - image storage example
# Copy this file to .env only in your local/private environment.
# Do not commit real Backblaze B2 credentials.

# hosting keeps the current behavior.
# backblaze uses only the remote/CDN URL when available.
# hybrid prefers remote/CDN and falls back to the current hosting/local path.
IMAGE_STORAGE_MODE=hosting

# Public base URL used by the catalog when images are available in Backblaze/CDN.
# Example: https://cdn.tu-dominio.com/catalogos
IMAGE_CDN_BASE_URL=

# Backblaze B2 credentials and endpoint.
# Keep these values private.
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=
