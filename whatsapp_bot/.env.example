BOT_NAME=Rodeo WhatsApp Bot
CURRENCY=USD

# Numeros autorizados separados por coma, en formato internacional sin simbolos.
# Ejemplo Panama: 50760000000
AUTHORIZED_NUMBERS=50762070678

# Mantener true en servidores Linux/cPanel/VPS sin entorno grafico.
PUPPETEER_NO_SANDBOX=true

# En Windows, usar Chrome instalado para evitar descargar Chromium durante npm install.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# FASE 2: fuente del catalogo.
# Preferido si existe: catalog.json publico.
# Alternativa si el catalogo carga por API: public_catalog.php?slug=SLUG
CATALOG_JSON_SOURCE=https://rodeoimportzl.com/catalogos_api/public_catalog.php?slug=nueva-entrada
CATALOG_CACHE_SECONDS=60

# FASE 4: token manual opcional para probar links de vendedor.
# En una fase posterior se resolvera desde vendedores reales.
DEFAULT_SELLER_TOKEN=

# FASE 5: conexion opcional solo lectura para resolver vendedor por telefono.
# Si queda vacia, el bot sigue usando DEFAULT_SELLER_TOKEN.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=3
